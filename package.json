{
  "name": "build-wonders-over-antiquated-buildings-dev",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-only tooling for the Build Wonders Over Antiquated Buildings Civ VII mod (type-check + lint + tests). Not shipped.",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint ui lib",
    "test": "node ./tests/eligibility.mjs",
    "readme:pdf": "bash scripts/build_readme_pdf.sh",
    "verify": "tsc --noEmit && eslint ui lib && node ./tests/eligibility.mjs",
    "release:gate": "npm run verify"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.4.0"
  }
}
