<?xml version="1.0" encoding="utf-8"?>
<!--
  Build Wonders Over Antiquated Buildings

  On the Wonder placement screen, urban tiles whose buildings are all from an earlier age are
  offered as sites. Choosing one clears the tile (its buildings go, its walls stay), queues the
  Wonder there through the game's own path, and hands the displaced citizens to the game's Grow
  City prompt so the player places them. The tile becomes a real Wonder district.

  No database change. Wonders keep their class, uniqueness, cinematics, terrain rules and AI
  behavior. One game script; the engine steps it relies on are in docs/RECIPE.md. Two rows in
  Options > Add-ons (a switch, and how old a building has to be) are in docs/OPTIONS.md.

  AffectsSavedGames=0: nothing is added to the database, so a save loads with the mod on or off,
  and a Wonder already built this way is ordinary constructible state.
-->
<Mod id="tower-build-wonders-over-antiquated-buildings" version="1" xmlns="ModInfo">
	<Properties>
		<Name>LOC_BWAB_NAME</Name>
		<Description>LOC_BWAB_DESCRIPTION</Description>
		<Authors>Tower</Authors>
		<Package>BuildWondersOverAntiquatedBuildings</Package>
		<PackageSortIndex>1000</PackageSortIndex>
		<AffectsSavedGames>0</AffectsSavedGames>
		<ShowInBrowser>1</ShowInBrowser>
		<Version>1.1.1</Version>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME"/>
	</Dependencies>
	<ActionCriteria>
		<Criteria id="always">
			<AlwaysMet></AlwaysMet>
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<!-- Shell scope: the name and description render in the Additional Content browser,
		     which runs before any game is loaded. -->
		<ActionGroup id="bwab-shell" scope="shell" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModText.xml</Item>
					<Item locale="de_DE">text/de_de/ModText.xml</Item>
					<Item locale="es_ES">text/es_es/ModText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
					<Item locale="it_IT">text/it_it/ModText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
				</UpdateText>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<!-- The two rows in Options > Add-ons; in the main menu they set what the next game uses. -->
					<Item>ui/bwab-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/bwab-options.js</Item>
					<Item>ui/bwab-settings.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
		<ActionGroup id="bwab-game" scope="game" criteria="always">
			<Actions>
				<UpdateText>
					<Item>text/en_us/ModText.xml</Item>
					<Item locale="de_DE">text/de_de/ModText.xml</Item>
					<Item locale="es_ES">text/es_es/ModText.xml</Item>
					<Item locale="fr_FR">text/fr_fr/ModText.xml</Item>
					<Item locale="it_IT">text/it_it/ModText.xml</Item>
					<Item locale="ja_JP">text/ja_jp/ModText.xml</Item>
					<Item locale="ko_KR">text/ko_kr/ModText.xml</Item>
					<Item locale="pl_PL">text/pl_pl/ModText.xml</Item>
					<Item locale="pt_BR">text/pt_br/ModText.xml</Item>
					<Item locale="ru_RU">text/ru_ru/ModText.xml</Item>
					<Item locale="zh_Hans_CN">text/zh_cn/ModText.xml</Item>
					<Item locale="zh_Hant_HK">text/zh_hk/ModText.xml</Item>
				</UpdateText>
				<UIScripts>
					<!-- Tower Settings Keeper: listed first, imports nothing, so it runs before anything reads storage. -->
					<Item>ui/settings-keeper.js</Item>
					<Item>ui/bwab-clear-and-build.js</Item>
					<Item>ui/bwab-options.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/bwab-options.js</Item>
					<Item>ui/bwab-settings.js</Item>
				</ImportFiles>
			</Actions>
		</ActionGroup>
	</ActionGroups>
</Mod>
